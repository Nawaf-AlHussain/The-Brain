# The Brain — environment configuration
# Copy to .env (Docker/local) or paste into Vercel → Settings → Environment Variables.

# ─────────────────────────────────────────────────────────────────────────────
# Deployment mode
# Auto-detected on Vercel (VERCEL=1). Force "serverless" on other
# ephemeral-filesystem hosts; leave unset for Docker/local (full features).
# ─────────────────────────────────────────────────────────────────────────────
# DEPLOYMENT_MODE=serverless

# ─────────────────────────────────────────────────────────────────────────────
# AI PROVIDER (required) — one OpenAI-compatible endpoint driving LLM, vision
# and embeddings. Works with: OpenAI, OpenRouter, DeepSeek, Groq, Together,
# Google Gemini (OpenAI-compatible endpoint), vLLM, LM Studio, llama.cpp…
# ─────────────────────────────────────────────────────────────────────────────
LLM_ENGINE=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-key-here

# Text model: entity extraction + query answering
LLM_MODEL=gpt-4o-mini
# Multimodal model: images / tables / equations (empty = disable vision)
VISION_MODEL=gpt-4o-mini
# Embedding model — EMBEDDING_DIM MUST match the model's output dimension!
#   OpenAI text-embedding-3-small -> 1536
#   OpenAI text-embedding-3-large -> 3072
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
MAX_EMBED_TOKENS=8192

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL: external reranker (recommended on serverless)
# Any Cohere-style POST {base}/rerank API works: SiliconFlow, Jina AI, Cohere.
# If unset: local bge-reranker model (Docker mode) or original-order fallback.
# ─────────────────────────────────────────────────────────────────────────────
# RERANKER_BASE_URL=https://api.siliconflow.com/v1
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RERANKER_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# NEO4J (required) — use Neo4j Aura DB (free tier) on Vercel:
# https://neo4j.com/cloud/aura/  → URI looks like neo4j+s://xxxx.databases.neo4j.io
# ─────────────────────────────────────────────────────────────────────────────
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-aura-password
NEO4J_DATABASE=neo4j

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL: persistent vector storage (recommended on serverless)
# Without it, vector indexes live in /tmp and are lost on instance recycling.
# Free tier: https://qdrant.tech/cloud/  (LightRAG reads QDRANT_API_KEY too)
# ─────────────────────────────────────────────────────────────────────────────
# QDRANT_URL=https://xxxx.eu-central-1.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Tuning
# ─────────────────────────────────────────────────────────────────────────────
CHUNK_SIZE=600
CHUNK_OVERLAP_SIZE=100
LLM_NUM_CTX=32768
LLM_TIMEOUT=120
LLM_MAX_ASYNC=2
EMBEDDING_TIMEOUT=60
EMBEDDING_MAX_ASYNC=2
# Max upload size in bytes (default: 4 MB on serverless, 500 MB in Docker)
# MAX_UPLOAD_BYTES=4194304
